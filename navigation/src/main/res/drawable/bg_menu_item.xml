<?xml version="1.0" encoding="utf-8"?>
<selector xmlns:android="http://schemas.android.com/apk/res/android">

    <item android:state_focused="true">
        <shape android:shape="rectangle">
            <corners android:radius="14dp" />
            <gradient
                android:angle="0"
                android:startColor="#CC000000"
                android:centerColor="?attr/colorAccent"
                android:endColor="?attr/colorAccent" />
            <stroke android:width="2dp" android:color="?attr/colorControlActivated" />
        </shape>
    </item>

    <item android:state_selected="true">
        <shape android:shape="rectangle">
            <corners android:radius="14dp" />
            <gradient
                android:angle="0"
                android:startColor="#B3000000"
                android:endColor="?attr/colorAccent" />
            <stroke android:width="1dp" android:color="?attr/colorAccent" />
        </shape>
    </item>

</selector>
