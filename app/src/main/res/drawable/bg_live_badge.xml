<?xml version="1.0" encoding="utf-8"?>
<shape xmlns:android="http://schemas.android.com/apk/res/android"
    android:shape="rectangle">

    <!-- Formato arredondado -->
    <corners android:radius="999dp" />

    <!-- Gradiente seguindo o tema -->
    <gradient
        android:type="linear"
        android:angle="0"
        android:startColor="?attr/app_background_color"
        android:centerColor="?attr/app_background_color"
        android:endColor="?attr/colorAccent" />

    <!-- Borda discreta na cor do tema -->
    <stroke
        android:width="1dp"
        android:color="?attr/colorAccent" />

</shape>
