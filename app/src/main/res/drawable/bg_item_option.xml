<?xml version="1.0" encoding="utf-8"?>
<selector xmlns:android="http://schemas.android.com/apk/res/android">

    <!-- Opção focada -->
    <item android:state_focused="true">
        <shape android:shape="rectangle">
            <corners android:radius="6dp" />

            <gradient
                android:angle="0"
                android:startColor="?attr/app_background_color"
                android:centerColor="?attr/colorAccent"
                android:endColor="?attr/colorAccent" />

            <stroke
                android:width="1dp"
                android:color="?attr/colorControlActivated" />
        </shape>
    </item>

    <!-- Opção pressionada -->
    <item android:state_pressed="true">
        <shape android:shape="rectangle">
            <corners android:radius="6dp" />

            <gradient
                android:angle="0"
                android:startColor="?attr/app_background_color"
                android:centerColor="?attr/colorAccent"
                android:endColor="?attr/colorAccent" />

            <stroke
                android:width="1dp"
                android:color="?attr/colorControlActivated" />
        </shape>
    </item>

    <!-- Opção normal: gradiente preto para cinza -->
    <item>
        <shape android:shape="rectangle">
            <corners android:radius="6dp" />

            <gradient
                android:angle="0"
                android:startColor="#CC000000"
                android:centerColor="?attr/app_background_color"
                android:endColor="?attr/colorAccent"
                android:centerX="0.88" />

            <stroke
                android:width="1dp"
                android:color="?attr/colorAccent" />
        </shape>
    </item>

</selector>
