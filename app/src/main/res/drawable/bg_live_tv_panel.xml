<?xml version="1.0" encoding="utf-8"?>
<shape xmlns:android="http://schemas.android.com/apk/res/android"
    android:shape="rectangle">

    <corners android:radius="12dp" />

    <!-- Fundo com gradiente suave do tema -->
    <gradient
        android:type="linear"
        android:angle="0"
        android:startColor="#D9000000"
        android:centerColor="#B3000000"
        android:endColor="?attr/app_background_color"
        android:centerX="0.86" />

    <!-- Borda seguindo a cor do tema -->
    <stroke
        android:width="1dp"
        android:color="?attr/colorAccent" />

</shape>
