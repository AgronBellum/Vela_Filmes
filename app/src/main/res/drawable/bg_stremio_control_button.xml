<?xml version="1.0" encoding="utf-8"?>
<selector xmlns:android="http://schemas.android.com/apk/res/android">

    <!-- Botão focado -->
    <item android:state_focused="true">
        <shape android:shape="rectangle">
            <corners android:radius="18dp" />

            <gradient
                android:angle="0"
                android:startColor="?attr/app_background_color"
                android:centerColor="?attr/colorAccent"
                android:endColor="?attr/colorAccent" />
            <stroke android:width="2dp" android:color="?attr/colorControlActivated" />
        </shape>
    </item>

    <!-- Botão pressionado -->
    <item android:state_pressed="true">
        <shape android:shape="rectangle">
            <corners android:radius="18dp" />

            <gradient
                android:angle="0"
                android:startColor="?attr/app_background_color"
                android:centerColor="?attr/colorAccent"
                android:endColor="?attr/colorAccent" />
            <stroke android:width="1dp" android:color="?attr/colorControlActivated" />
        </shape>
    </item>

    <!-- Botão normal: totalmente transparente -->
    <item>
        <shape android:shape="rectangle">
            <corners android:radius="18dp" />
            <solid android:color="#00000000" />
        </shape>
    </item>

</selector>
