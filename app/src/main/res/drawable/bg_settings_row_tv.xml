<?xml version="1.0" encoding="utf-8"?>
<selector xmlns:android="http://schemas.android.com/apk/res/android">

    <!-- Item focado -->
    <item android:state_focused="true">
        <shape android:shape="rectangle">
            <corners android:radius="22dp" />

            <gradient
                android:type="linear"
                android:angle="0"
                android:startColor="?attr/app_background_color"
                android:centerColor="?attr/colorAccent"
                android:endColor="?attr/colorAccent" />

            <stroke
                android:width="1dp"
                android:color="?attr/colorControlActivated" />
        </shape>
    </item>

    <!-- Item pressionado -->
    <item android:state_pressed="true">
        <shape android:shape="rectangle">
            <corners android:radius="22dp" />

            <gradient
                android:type="linear"
                android:angle="0"
                android:startColor="?attr/app_background_color"
                android:centerColor="?attr/colorAccent"
                android:endColor="?attr/colorAccent" />

            <stroke
                android:width="1dp"
                android:color="?attr/colorControlActivated" />
        </shape>
    </item>

    <!-- Item selecionado -->
    <item android:state_selected="true">
        <shape android:shape="rectangle">
            <corners android:radius="22dp" />

            <gradient
                android:type="linear"
                android:angle="0"
                android:startColor="?attr/app_background_color"
                android:endColor="?attr/colorAccent" />

            <stroke
                android:width="1dp"
                android:color="?attr/colorAccent" />
        </shape>
    </item>

    <!-- Item normal: gradiente suave do tema -->
    <item>
        <shape android:shape="rectangle">
            <corners android:radius="22dp" />

            <gradient
                android:type="linear"
                android:angle="0"
                android:startColor="#99000000"
                android:centerColor="?attr/app_background_color"
                android:endColor="?attr/colorAccent"
                android:centerX="0.9" />

            <stroke
                android:width="1dp"
                android:color="?attr/colorAccent" />
        </shape>
    </item>

</selector>
