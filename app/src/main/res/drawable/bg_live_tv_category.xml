<?xml version="1.0" encoding="utf-8"?>
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_focused="true">
        <shape>
            <gradient
                android:angle="0"
                android:startColor="#3A2C78"
                android:endColor="#211842" />
            <corners android:radius="8dp" />
            <stroke android:width="2dp" android:color="#A794FF" />
        </shape>
    </item>
    <item android:state_selected="true">
        <shape>
            <gradient
                android:angle="0"
                android:startColor="#7C5CFF"
                android:endColor="#4E37BB" />
            <corners android:radius="8dp" />
            <stroke android:width="1dp" android:color="#D8D0FF" />
        </shape>
    </item>
    <item>
        <shape>
            <solid android:color="#181425" />
            <corners android:radius="8dp" />
            <stroke android:width="1dp" android:color="#2E2944" />
        </shape>
    </item>
</selector>