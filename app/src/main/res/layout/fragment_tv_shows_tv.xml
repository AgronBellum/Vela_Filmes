<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto" xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent" android:layout_height="match_parent" android:background="#050505">
    <LinearLayout android:id="@+id/sidebar" android:layout_width="240dp" android:layout_height="0dp" android:background="#090909"
        android:orientation="vertical" app:layout_constraintStart_toStartOf="parent" app:layout_constraintTop_toTopOf="parent" app:layout_constraintBottom_toBottomOf="parent">
        <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:padding="18dp" android:text="SÉRIES"
            android:textColor="#F4C20D" android:textSize="20sp" android:textStyle="bold" />
        <androidx.recyclerview.widget.RecyclerView android:id="@+id/rv_categories" android:layout_width="match_parent" android:layout_height="0dp"
            android:layout_weight="1" android:clipToPadding="false" android:paddingBottom="24dp" />
    </LinearLayout>
    <EditText android:id="@+id/et_search" android:layout_width="0dp" android:layout_height="48dp" android:layout_marginStart="18dp"
        android:layout_marginTop="12dp" android:layout_marginEnd="12dp" android:hint="Pesquisar séries" android:singleLine="true"
        android:textColor="#FFFFFF" android:textColorHint="#888888" app:layout_constraintStart_toEndOf="@id/sidebar"
        app:layout_constraintEnd_toStartOf="@id/btn_filters" app:layout_constraintTop_toTopOf="parent" />
    <Button android:id="@+id/btn_filters" android:layout_width="wrap_content" android:layout_height="48dp" android:layout_marginTop="12dp"
        android:layout_marginEnd="18dp" android:text="Filtros" android:textAllCaps="false" app:layout_constraintEnd_toEndOf="parent" app:layout_constraintTop_toTopOf="parent" />
    <TextView android:id="@+id/tv_title" android:layout_width="0dp" android:layout_height="wrap_content" android:layout_marginStart="18dp"
        android:layout_marginTop="10dp" android:textColor="#FFFFFF" android:textSize="22sp" android:textStyle="bold"
        app:layout_constraintStart_toEndOf="@id/sidebar" app:layout_constraintEnd_toEndOf="parent" app:layout_constraintTop_toBottomOf="@id/et_search" />
    <LinearLayout android:id="@+id/filter_summary" android:layout_width="0dp" android:layout_height="42dp" android:orientation="horizontal"
        android:gravity="center_vertical" android:paddingStart="18dp" android:paddingEnd="18dp" app:layout_constraintStart_toEndOf="@id/sidebar"
        app:layout_constraintEnd_toEndOf="parent" app:layout_constraintTop_toBottomOf="@id/tv_title">
        <TextView android:id="@+id/tv_filter_summary" android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1"
            android:textColor="#F4C20D" android:singleLine="true" />
        <Button android:id="@+id/btn_clear_filters" android:layout_width="wrap_content" android:layout_height="40dp" android:text="Limpar filtros"
            android:textAllCaps="false" android:visibility="gone" />
    </LinearLayout>
    <androidx.leanback.widget.VerticalGridView android:id="@+id/vgv_tv_shows" android:layout_width="0dp" android:layout_height="0dp"
        android:clipChildren="false" android:clipToPadding="false" android:padding="14dp" app:numberOfColumns="5" app:focusOutEnd="true"
        app:layout_constraintStart_toEndOf="@id/sidebar" app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toBottomOf="@id/filter_summary" app:layout_constraintBottom_toBottomOf="parent" tools:listitem="@layout/item_tv_show_grid" />
    <TextView android:id="@+id/tv_empty" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Nenhuma série encontrada"
        android:textColor="#BDBDBD" android:textSize="18sp" android:visibility="gone" app:layout_constraintTop_toTopOf="@id/vgv_tv_shows"
        app:layout_constraintBottom_toBottomOf="@id/vgv_tv_shows" app:layout_constraintStart_toStartOf="@id/vgv_tv_shows" app:layout_constraintEnd_toEndOf="@id/vgv_tv_shows" />
    <include android:id="@+id/is_loading" layout="@layout/layout_is_loading_tv" android:layout_width="0dp" android:layout_height="0dp"
        app:layout_constraintStart_toEndOf="@id/sidebar" app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toBottomOf="@id/filter_summary" app:layout_constraintBottom_toBottomOf="parent" />
</androidx.constraintlayout.widget.ConstraintLayout>
