<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/cl_exo_controller"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <View
        android:id="@id/exo_controls_background"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:background="#33000000"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        tools:visibility="gone" />

    <LinearLayout
        android:id="@+id/header_group"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginStart="20dp"
        android:layout_marginTop="18dp"
        android:layout_marginEnd="20dp"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        app:layout_constraintEnd_toStartOf="@id/btn_exo_external_player"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent">

        <TextView
            android:layout_width="24dp"
            android:layout_height="24dp"
            android:gravity="center"
            android:text="&#8249;"
            android:textColor="#FFFFFFFF"
            android:textSize="28sp"
            tools:ignore="HardcodedText" />

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="6dp"
            android:layout_weight="1"
            android:orientation="vertical">

            <TextView
                android:id="@+id/tv_exo_title"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:ellipsize="end"
                android:maxLines="1"
                android:textColor="#FFFFFFFF"
                android:textSize="13sp"
                android:textStyle="bold"
                tools:text="Episode 1" />

            <TextView
                android:id="@+id/tv_exo_subtitle"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:ellipsize="end"
                android:maxLines="1"
                android:textColor="#99FFFFFF"
                android:textSize="11sp"
                tools:text="Season 1" />
        </LinearLayout>
    </LinearLayout>

    <ImageView
        android:id="@+id/btn_exo_external_player"
        android:layout_width="36dp"
        android:layout_height="36dp"
        android:layout_marginTop="14dp"
        android:layout_marginEnd="20dp"
        android:background="@drawable/bg_stremio_control_button"
        android:focusable="true"
        android:focusableInTouchMode="true"
        android:nextFocusLeft="@id/exo_settings"
        android:nextFocusRight="@id/btn_exo_external_player"
        android:padding="9dp"
        android:src="@drawable/exo_styled_controls_external_player"
        android:tint="#FFFFFFFF"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        tools:ignore="ContentDescription,PrivateResource,UseAppTint" />

    <TextView
        android:id="@+id/btn_skip_intro"
        android:layout_width="wrap_content"
        android:layout_height="34dp"
        android:layout_marginEnd="26dp"
        android:layout_marginBottom="72dp"
        android:background="@drawable/bg_stremio_skip_button"
        android:drawableStart="@drawable/exo_styled_controls_fastforward"
        android:drawableTint="#FFFFFFFF"
        android:drawablePadding="6dp"
        android:focusable="true"
        android:gravity="center"
        android:paddingStart="14dp"
        android:paddingEnd="14dp"
        android:text="@string/player_skip_intro"
        android:textColor="#FFFFFFFF"
        android:textSize="11sp"
        android:visibility="gone"
        app:layout_constraintBottom_toTopOf="@id/exo_progress"
        app:layout_constraintEnd_toEndOf="parent"
        tools:visibility="visible" />
    <LinearLayout
        android:id="@+id/exo_center_controls"
        android:layout_width="wrap_content"
        android:layout_height="72dp"
        android:gravity="center"
        android:orientation="horizontal"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent">

        <ImageView
            android:id="@+id/btn_custom_prev"
            android:layout_width="58dp"
            android:layout_height="58dp"
            android:background="@drawable/bg_stremio_control_button"
            android:focusable="true"
            android:focusableInTouchMode="true"
            android:nextFocusRight="@id/exo_rew"
            android:nextFocusDown="@id/exo_progress"
            android:padding="14dp"
            android:src="@drawable/ic_previous"
            app:tint="#FFFFFFFF"
            tools:ignore="ContentDescription" />

        <ImageView
            android:id="@+id/exo_rew"
            android:layout_width="58dp"
            android:layout_height="58dp"
            android:layout_marginStart="10dp"
            android:background="@drawable/bg_stremio_control_button"
            android:focusable="true"
            android:focusableInTouchMode="true"
            android:nextFocusLeft="@id/btn_custom_prev"
            android:nextFocusRight="@id/exo_replay"
            android:nextFocusDown="@id/exo_progress"
            android:padding="14dp"
            android:src="@drawable/exo_styled_controls_rewind"
            android:tint="#FFFFFFFF"
            tools:ignore="ContentDescription,PrivateResource,UseAppTint" />

        <ImageView
            android:id="@+id/exo_replay"
            android:layout_width="58dp"
            android:layout_height="58dp"
            android:layout_marginStart="10dp"
            android:background="@drawable/bg_stremio_control_button"
            android:focusable="true"
            android:focusableInTouchMode="true"
            android:nextFocusLeft="@id/exo_rew"
            android:nextFocusRight="@id/exo_play_pause"
            android:nextFocusDown="@id/exo_progress"
            android:padding="14dp"
            android:src="@drawable/ic_refresh"
            app:tint="#FFFFFFFF"
            tools:ignore="ContentDescription" />

        <ImageView
            android:id="@id/exo_play_pause"
            android:layout_width="74dp"
            android:layout_height="74dp"
            android:layout_marginStart="12dp"
            android:layout_marginEnd="12dp"
            android:background="@drawable/bg_stremio_control_button"
            android:focusable="true"
            android:focusableInTouchMode="true"
            android:nextFocusLeft="@id/exo_replay"
            android:nextFocusRight="@id/exo_ffwd"
            android:nextFocusDown="@id/exo_progress"
            android:padding="16dp"
            android:src="@drawable/exo_styled_controls_play"
            android:tint="#FFFFFFFF"
            tools:ignore="ContentDescription,PrivateResource,UseAppTint" />

        <ImageView
            android:id="@+id/exo_ffwd"
            android:layout_width="58dp"
            android:layout_height="58dp"
            android:background="@drawable/bg_stremio_control_button"
            android:focusable="true"
            android:focusableInTouchMode="true"
            android:nextFocusLeft="@id/exo_play_pause"
            android:nextFocusRight="@id/btn_custom_next"
            android:nextFocusDown="@id/exo_progress"
            android:padding="14dp"
            android:src="@drawable/exo_styled_controls_fastforward"
            android:tint="#FFFFFFFF"
            tools:ignore="ContentDescription,PrivateResource,UseAppTint" />

        <ImageView
            android:id="@+id/btn_custom_next"
            android:layout_width="58dp"
            android:layout_height="58dp"
            android:layout_marginStart="10dp"
            android:background="@drawable/bg_stremio_control_button"
            android:focusable="true"
            android:focusableInTouchMode="true"
            android:nextFocusLeft="@id/exo_ffwd"
            android:nextFocusRight="@id/btn_custom_next"
            android:nextFocusDown="@id/exo_progress"
            android:padding="14dp"
            android:src="@drawable/ic_next"
            app:tint="#FFFFFFFF"
            tools:ignore="ContentDescription" />

    </LinearLayout>


    <androidx.media3.ui.DefaultTimeBar
        android:id="@id/exo_progress"
        android:layout_width="0dp"
        android:layout_height="18dp"
        android:layout_marginStart="20dp"
        android:layout_marginEnd="20dp"
        android:layout_marginBottom="30dp"
        android:focusable="true"
        android:focusableInTouchMode="true"
        android:nextFocusDown="@id/btn_exo_subtitles"
        app:bar_height="2dp"
        app:buffered_color="#665B4FB8"
        app:layout_constraintBottom_toTopOf="@id/exo_bottom_bar"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:played_color="#7C5CFF"
        app:scrubber_color="#7C5CFF"
        app:scrubber_disabled_size="0dp"
        app:scrubber_dragged_size="10dp"
        app:scrubber_enabled_size="7dp"
        app:unplayed_color="#40FFFFFF" />

    <androidx.constraintlayout.widget.ConstraintLayout
        android:id="@id/exo_bottom_bar"
        android:layout_width="0dp"
        android:layout_height="52dp"
        android:layout_marginStart="20dp"
        android:layout_marginEnd="20dp"
        android:layout_marginBottom="10dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent">

        <TextView
            android:id="@id/exo_position"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:textColor="#FFFFFFFF"
            android:textSize="10sp"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            tools:text="00:00:00" />

        <TextView
            android:id="@id/exo_duration"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:textColor="#CCFFFFFF"
            android:textSize="10sp"
            app:layout_constraintBottom_toTopOf="@id/exo_settings"
            app:layout_constraintEnd_toEndOf="parent"
            tools:text="02:33:45" />

        <TextView
            android:id="@+id/tv_time_separator"
            android:layout_width="0dp"
            android:layout_height="0dp"
            android:visibility="gone" />

        <ImageView
            android:id="@+id/btn_exo_subtitles"
            android:layout_width="34dp"
            android:layout_height="34dp"
            android:layout_marginEnd="4dp"
            android:background="@drawable/bg_stremio_control_button"
            android:focusable="true"
            android:focusableInTouchMode="true"
            android:nextFocusLeft="@id/btn_exo_subtitles"
            android:nextFocusRight="@id/btn_exo_audio"
            android:nextFocusUp="@id/exo_progress"
            android:padding="8dp"
            android:src="@drawable/ic_player_settings_subtitle_on"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toStartOf="@id/btn_exo_audio"
            app:tint="#FFFFFFFF"
            tools:ignore="ContentDescription" />

        <ImageView
            android:id="@+id/btn_exo_audio"
            android:layout_width="34dp"
            android:layout_height="34dp"
            android:layout_marginEnd="4dp"
            android:background="@drawable/bg_stremio_control_button"
            android:focusable="true"
            android:focusableInTouchMode="true"
            android:nextFocusLeft="@id/btn_exo_subtitles"
            android:nextFocusRight="@id/btn_exo_servers"
            android:nextFocusUp="@id/exo_progress"
            android:padding="8dp"
            android:src="@drawable/ic_player_settings_audio"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toStartOf="@id/btn_exo_servers"
            app:tint="#FFFFFFFF"
            tools:ignore="ContentDescription" />

        <ImageView
            android:id="@+id/btn_exo_servers"
            android:layout_width="34dp"
            android:layout_height="34dp"
            android:layout_marginEnd="4dp"
            android:background="@drawable/bg_stremio_control_button"
            android:focusable="true"
            android:focusableInTouchMode="true"
            android:nextFocusLeft="@id/btn_exo_audio"
            android:nextFocusRight="@id/btn_exo_aspect_ratio"
            android:nextFocusUp="@id/exo_progress"
            android:padding="8dp"
            android:src="@drawable/ic_player_settings_servers"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toStartOf="@id/btn_exo_aspect_ratio"
            app:tint="#FFFFFFFF"
            tools:ignore="ContentDescription" />

        <ImageView
            android:id="@id/btn_exo_aspect_ratio"
            android:layout_width="34dp"
            android:layout_height="34dp"
            android:layout_marginEnd="4dp"
            android:background="@drawable/bg_stremio_control_button"
            android:focusable="true"
            android:focusableInTouchMode="true"
            android:nextFocusLeft="@id/btn_exo_servers"
            android:nextFocusRight="@id/exo_settings"
            android:nextFocusUp="@id/exo_progress"
            android:padding="8dp"
            android:src="@drawable/exo_styled_controls_aspect_ratio"
            android:tint="#FFFFFFFF"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toStartOf="@id/exo_settings"
            tools:ignore="ContentDescription,PrivateResource,UseAppTint" />

        <ImageView
            android:id="@id/exo_settings"
            android:layout_width="34dp"
            android:layout_height="34dp"
            android:background="@drawable/bg_stremio_control_button"
            android:focusable="true"
            android:focusableInTouchMode="true"
            android:nextFocusLeft="@id/btn_exo_aspect_ratio"
            android:nextFocusRight="@id/exo_settings"
            android:nextFocusUp="@id/exo_progress"
            android:padding="8dp"
            android:src="@drawable/exo_styled_controls_settings"
            android:tint="#FFFFFFFF"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            tools:ignore="ContentDescription,PrivateResource,UseAppTint" />

    </androidx.constraintlayout.widget.ConstraintLayout>

</androidx.constraintlayout.widget.ConstraintLayout>
